# Secretos
.env
.env.*
!.env.example
CLAUDE.md
# Datos locales por si se usan bind mounts en lugar de volúmenes
data/
db_data/
wp_html/
wordpress/
mysql/
*.sql
*.sql.gz

# Evidencias: las capturas por fase si se versionan para el equipo documental;
# el registro y el Word de entrega quedan solo en local.
evidencias/*
!evidencias/capturas/
informe/
scripts/generar_evidencias.py
requirements.txt

# Reportes que contienen credenciales, cookies o tokens capturados
reportes/**/*_sensible.*
reportes/**/*.har
reportes/**/hydra*.restore

# Sistema y editores
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/*
!.vscode/extensions.json
.idea/

# Archivos temporales del MCP de Playwright
.playwright-mcp/

# Temporales de Office
~$*

# Dependencias PHP del plugin; se instalan con composer
plugin-consulta-pedidos/*/vendor/

# Assets del reporte HTML de ZAP (el HTML va con sufijo _sensible, fuera del repo)
reportes/**/*_zap_caja-negra/

# Docker secrets generados desde .env
secrets/

# Reportes HTML de las herramientas (pesados y regenerables con los scripts)
reportes/**/html/
