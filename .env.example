# Copia este archivo como .env (cp .env.example .env) y cambia las contraseñas de ejemplo.

# Base de datos
MYSQL_ROOT_PASSWORD=cambiar_root_ejemplo
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=cambiar_wpuser_ejemplo
# Cámbialo si el puerto 3306 ya está ocupado en tu equipo.
DB_PUERTO_HOST=3306

# WordPress
WP_URL=http://localhost:8080
WP_TITULO=Tienda UMG
WP_TABLE_PREFIX=wp_
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=cambiar_admin_ejemplo
WP_ADMIN_EMAIL=admin@tienda-umg.test

# WooCommerce
WOOCOMMERCE_VERSION=11.3.0

# Usuarios de prueba: gestor (shop_manager), editor, y cliente1/cliente2 (customer) para probar IDOR.
GESTOR_PASSWORD=cambiar_gestor_ejemplo
EDITOR_PASSWORD=cambiar_editor_ejemplo
CLIENTE_PASSWORD=cambiar_cliente_ejemplo

# Pon 0 para no crear productos ni pedidos de ejemplo.
CREAR_DATOS_EJEMPLO=1
